<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic for local development -->
    <!-- This is ONLY for connecting to the local Python server on your machine -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Specifically allow connection to your local machine -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.2.2 is the emulator's alias for your host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Add your local IP if needed -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>